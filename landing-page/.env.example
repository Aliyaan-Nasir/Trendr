# URL of the Trendr app that the "Launch App" buttons open.
# Defaults to http://localhost:3000 (the frontend dev server) when unset.
# Production: https://app.trendr.bid
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The Trendr backend the Mainnet waitlist form posts to.
# Defaults to http://localhost:4000 (the local backend) when unset; the backend's LANDING_URL must
# list this site's origin (locally http://localhost:3004).
# Production: https://api.trendr.bid
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Public origin of this site, for canonical URLs, Open Graph tags and the sitemap.
# Defaults to https://trendr.bid when unset.
# NEXT_PUBLIC_SITE_URL=https://trendr.bid
