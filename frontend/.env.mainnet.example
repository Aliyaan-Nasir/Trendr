# Monad Mainnet: only the values that differ from .env.example. Every value is inlined at build time,
# so set them before `npm run build`. docs/mainnet.md has the runbook.

NEXT_PUBLIC_CHAIN_ID=143
NEXT_PUBLIC_BACKEND_URL=https://api.trendr.bid
NEXT_PUBLIC_RELAYER_URL=https://relayer.trendr.bid
# Read endpoints in order of preference, comma-separated; the default for 143 is the public RPC alone.
NEXT_PUBLIC_RPC_URLS=https://your-rpc.example
NEXT_PUBLIC_WS_URLS=wss://your-rpc.example
NEXT_PUBLIC_APP_URL=https://app.trendr.bid
# Required on Mainnet: without it the app falls back to the Testnet bot wallet.
NEXT_PUBLIC_TRENDR_BOT_ADDRESS=<mainnet bot wallet>
# The passkey relying party: the registrable domain, so passkeys work on every subdomain. It is
# fixed for good: passkeys, and the accounts derived from them, are bound to it.
NEXT_PUBLIC_PASSKEY_RP_ID=trendr.bid
