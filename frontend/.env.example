# Copy to .env.local and fill in. Every NEXT_PUBLIC_ value is inlined into the bundle at build time,
# so set them before `npm run build`. Leave optional values commented out rather than empty: an
# empty value replaces the default. Mainnet values are in .env.mainnet.example.

# Chain: 10143 (Testnet) or 143 (Mainnet). Contract addresses come from @trendr/contracts.
NEXT_PUBLIC_CHAIN_ID=10143

# Trendr backend and relayer. The browser calls both directly, so the backend's FRONTEND_URL and the
# relayer's ALLOWED_ORIGINS must list this app's origin.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_RELAYER_URL=http://localhost:4100
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Read RPC endpoints in order of preference, comma-separated, and the head stream's WebSocket
# endpoints (a dropped stream moves to the next). Defaults: Monad's public endpoints for the chain.
# NEXT_PUBLIC_RPC_URLS=
# NEXT_PUBLIC_WS_URLS=

# The Trendr bot wallet Autopilot shows and copies. Defaults to the Testnet bot.
# NEXT_PUBLIC_TRENDR_BOT_ADDRESS=

# Passkey relying party id. Defaults to the page's hostname. In production it is the registrable
# domain (trendr.bid), so passkeys work on every subdomain; it never changes once people sign up.
# NEXT_PUBLIC_PASSKEY_RP_ID=

# A deployment JSON instead of the bundled one (forks and local chains).
# NEXT_PUBLIC_DEPLOYMENT_JSON=
