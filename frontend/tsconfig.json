{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-stepup/types/**/*.ts",
    ".next-stepup/dev/types/**/*.ts",
    ".next-copy/types/**/*.ts",
    ".next-copy/dev/types/**/*.ts",
    ".next-3006/types/**/*.ts",
    ".next-3006/dev/types/**/*.ts",
    ".next-sec/types/**/*.ts",
    ".next-sec/dev/types/**/*.ts",
    ".next-lev/types/**/*.ts",
    ".next-lev/dev/types/**/*.ts",
    ".next-final/types/**/*.ts",
    ".next-final/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e/stack.ts",
    "test"
  ]
}
