# Envio HyperIndex settings for the Trendr indexer. Copy to .env and fill in; .env is gitignored.

# HyperSync API token (https://envio.dev/app/api-tokens). Required: every chain is synced over HyperSync.
ENVIO_API_TOKEN=

# Postgres the indexer writes to and the Trendr backend reads from.
ENVIO_PG_HOST=localhost
ENVIO_PG_PORT=5432
ENVIO_PG_USER=trendr
ENVIO_PG_PASSWORD=
ENVIO_PG_DATABASE=trendr_envio
# A schema of its own: `envio start -r` drops and recreates it, so never point this at a schema
# other services use (such as the backend's public schema).
ENVIO_PG_SCHEMA=indexer
# require, allow, prefer or verify-full; leave unset for a local database.
# ENVIO_PG_SSL_MODE=require

# No Hasura and no terminal UI: the backend queries Postgres directly.
ENVIO_HASURA=false
ENVIO_TUI=false

# Port of /healthz and /metrics (default 9898).
# ENVIO_INDEXER_PORT=9898

# RPC that follows the chain head once history is synced over HyperSync, and serves the cached
# Perpl market reads (about 20 requests a second at the head, see README.md "Request volume").
# Defaults to the public Monad Testnet RPC.
ENVIO_RPC_URL_10143=https://testnet-rpc.monad.xyz

# Envio fails over in order (no load sharing) when the head RPC stalls: first this one (default
# Monad Foundation's monadinfra endpoint), then the last resort (default Ankr's keyless endpoint),
# each from a different provider than the head RPC. A key used only here keeps its quota for that.
# ENVIO_RPC_FALLBACK_URL_10143=
# ENVIO_RPC_LAST_RESORT_URL_10143=

# First block to index. Defaults to the deployment's first block (the full history). A later block
# skips everything created before it; Envio keeps the block it started from, so changing it needs
# `envio start --restart`.
# ENVIO_START_BLOCK_10143=
