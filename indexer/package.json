{
  "name": "@trendr/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Envio HyperIndex indexer for Trendr on Monad: trends, outcome series, Kuru markets, attention perps, curves, curation and Trendr users' Perpl activity.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "codegen": "envio codegen",
    "start": "envio start",
    "resync": "envio start --restart",
    "mainnet:config": "node --experimental-strip-types scripts/mainnet-config.ts",
    "start:mainnet": "ENVIO_CONFIG=config.mainnet.yaml envio start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test"
  },
  "dependencies": {
    "envio": "3.14.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
