# Monad Mainnet: only the values that differ from .env.example. The Mainnet indexer is its own
# process with its own database, started with `pnpm start:mainnet` (ENVIO_CONFIG=config.mainnet.yaml,
# written by `pnpm mainnet:config` from contracts/deployments/143.json). README.md has the steps.

ENVIO_PG_HOST=<host>
ENVIO_PG_PASSWORD=<password>
ENVIO_PG_DATABASE=<mainnet-indexer-db>
ENVIO_PG_SSL_MODE=require
# Follows the Mainnet head once HyperSync (143.hypersync.xyz, same token) has backfilled history.
# A dedicated provider key; on Alchemy's free tier keep interval_ceiling at 10 blocks.
ENVIO_RPC_URL_143=https://your-rpc.example
# Its own health port when it runs next to the Testnet indexer.
# ENVIO_INDEXER_PORT=9899
