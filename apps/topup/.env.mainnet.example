# Monad Mainnet: only the values that differ from .env.example. Start from .env.example, then apply
# these. docs/mainnet.md has the runbook. Never commit the filled-in file.

RPC_URL=https://your-rpc.example
# Comma-separated, load balanced with failover.
RPC_URLS=https://your-rpc.example
CHAIN_ID=143
# Transfers move real MON: the service refuses CHAIN_ID=143 without this.
ALLOW_MAINNET=1
RPC_MAX_RPS=10
# A new Mainnet treasury key, never the Testnet one.
TREASURY_PRIVATE_KEY=<0x mainnet treasury key>
# Smaller caps than Testnet: Mainnet burns less (oracle broadcaster about 10 MON a day in mock mode
# at twelve live trends, keeper about 3.6, relayer keys 0.04 to 0.07 MON a relayed trade) and every
# MON is real. There is no AUSD faucet on Mainnet. List the oracle only while it broadcasts from its
# own key (mock mode) rather than the DON; docs/mainnet.md has the measured budget.
TARGETS=oracle:0xYourOracleAddress:5:20:20:40
# On top of Monad's 10 MON reserve balance.
TREASURY_RESERVE_MON=5
COOLDOWN_SEC=900
MAX_REFILLS_PER_HOUR=2
RUNWAY_ALERT_DAYS=7
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>
ADMIN_TOKEN=<random string of at least 24 characters>
ALERT_WEBHOOK_URL=<slack or discord webhook>
