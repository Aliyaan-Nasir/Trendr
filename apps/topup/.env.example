# Monad RPC and chain.
RPC_URL=https://testnet-rpc.monad.xyz
# Several endpoints to load-balance across (round robin with failover), comma-separated. RPC_URL
# alone when unset.
RPC_URLS=
CHAIN_ID=10143
# Requests per second per endpoint. The public RPC allows 15 per IP across all processes.
RPC_MAX_RPS=5
# The treasury's key: it holds the MON that funds every wallet below. Generate one with
# `cast wallet new` and fund only the treasury.
TREASURY_PRIVATE_KEY=
# Wallets to keep funded, highest priority first, as name:address:min:target:maxPerTransfer:maxPerDay
# with amounts in MON, separated by commas or newlines. A wallet below min is refilled up to target.
# Sized from the measured Testnet burn: oracle broadcaster about 21 MON a day, market maker 12,
# keeper 7; the relayer varies with use; the Autopilot bot and the backend faucet spend little.
TARGETS=oracle:0xYourOracleAddress:25:75:75:120
CHECK_INTERVAL_SEC=120
# The treasury never sends below TREASURY_RESERVE_MON plus Monad's reserve balance
# (MONAD_RESERVE_MON, 10 MON on Monad Mainnet and Testnet when unset): a transfer that leaves the
# sender under 10 MON reverts and still pays gas.
TREASURY_RESERVE_MON=2
MONAD_RESERVE_MON=
# No second transfer to a wallet within this many seconds of the last one.
COOLDOWN_SEC=600
# More full refills than this within an hour halts a wallet (a drain or a bug) until released.
MAX_REFILLS_PER_HOUR=3
# Smallest transfer worth sending when the treasury or a daily cap allows only part of a refill.
MIN_TRANSFER_MON=0.1
# Alert when the treasury lasts fewer days than this at the observed burn.
RUNWAY_ALERT_DAYS=3
# Gas cap for a transfer to a wallet with code (an EIP-7702 delegation); plain wallets take 21000.
DELEGATED_GAS_CAP=100000
# 1 logs what it would send and sends nothing (with its own state, apart from the live service's).
DRY_RUN=
# Postgres for the transfer ledger, halts and alert state (its own table, topup_state). Use a
# direct session connection, not a transaction pooler: the advisory lock that stops a second
# instance from sending needs one. Unset, state goes to STATE_FILE, one instance only.
DATABASE_URL=
STATE_FILE=.topup-state.json
# Enables POST /targets/<name>/release (Authorization: Bearer <token>) to resume a halted wallet.
ADMIN_TOKEN=
PORT=4500
# Optional Slack or Discord webhook for alerts.
ALERT_WEBHOOK_URL=
LOG_LEVEL=info
