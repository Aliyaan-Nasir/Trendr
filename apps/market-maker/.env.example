# Monad RPC, WebSocket and chain. Contract addresses come from @trendr/contracts deployments.
RPC_URL=https://testnet-rpc.monad.xyz
WS_URL=wss://testnet-rpc.monad.xyz
# Several endpoints to load-balance across (round robin with failover), comma-separated.
# RPC_URL and WS_URL alone when unset.
RPC_URLS=
WS_URLS=
CHAIN_ID=10143
# Requests per second to RPC_URL. The public RPC allows 15 per IP across all processes.
RPC_MAX_RPS=10
# The market maker's own key: it holds AUSD inventory and MON for gas.
MM_PRIVATE_KEY=
PORT=4300
QUOTE_WINDOWS=86400,604800
# Complete sets (AUSD) minted per series, and AUSD kept in Kuru's MarginAccount for bids (shared by
# every quoted series, so it must cover MAX_SERIES x 2 sides x LEVELS x LEVEL_TOKENS at about 0.5).
SETS_PER_SERIES=100
MARGIN_AUSD=1500
# Quote shape: prices in AUSD per token.
HALF_SPREAD=0.03
LEVEL_STEP=0.01
LEVELS=2
LEVEL_TOKENS=20
MAX_SKEW=0.03
INVENTORY_LIMIT=60
# Re-quote when a price is this many ticks (0.001 AUSD) off; keep it under HALF_SPREAD.
REQUOTE_TICKS=20
STOP_BEFORE_EXPIRY_SEC=300
ARB_MIN_EDGE=0.005
ARB_MAX_TOKENS=200
QUOTE_EVERY_BLOCKS=25
# Set KILL_SWITCH to anything, or create KILL_SWITCH_FILE, to pull every quote.
KILL_SWITCH=
KILL_SWITCH_FILE=
STATE_FILE=.mm-state.json
ALERT_WEBHOOK_URL=
LOG_LEVEL=info
# MON the key must hold to keep quoting (a re-quote reserves up to 2.5M gas); below it /health is red.
MIN_BALANCE_MON=0.5
# Gas budget: quote at most this many series (24h windows first, then by attention), and space out
# drift-only re-quotes of a market; fills and large moves still re-quote at once.
MAX_SERIES=10
MIN_REQUOTE_SEC=300
