# Monad Mainnet: only the values that differ from .env.example. Start from .env.example, then apply
# these. docs/mainnet.md has the runbook. Never commit the filled-in file.
# The maker quotes only markets recorded in OutcomeListing, so it idles until Kuru deploys them.

RPC_URL=https://your-rpc.example
WS_URL=wss://your-rpc.example
# Comma-separated, load balanced with failover.
RPC_URLS=https://your-rpc.example
WS_URLS=wss://your-rpc.example
CHAIN_ID=143
RPC_MAX_RPS=25
# A new Mainnet key holding AUSD inventory and MON for gas. A first order on a level uses about
# 0.32M to 0.34M gas (about 0.04 MON with the 20% gas pad).
MM_PRIVATE_KEY=<0x mainnet market maker key>
# AUSD at risk: SETS_PER_SERIES x MAX_SERIES in complete sets plus MARGIN_AUSD for bids.
SETS_PER_SERIES=100
MARGIN_AUSD=1500
MAX_SERIES=10
MIN_BALANCE_MON=5
# A new state file: the Testnet one holds Testnet order ids, and the file is not keyed by chain.
STATE_FILE=.mm-state.mainnet.json
ALERT_WEBHOOK_URL=<slack or discord webhook>
