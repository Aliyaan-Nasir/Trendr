# Monad Mainnet: only the values that differ from .env.example. Start from .env.example, then apply
# these. docs/mainnet.md has the runbook. Never commit the filled-in file.

DATABASE_URL=postgres://<user>:<password>@<host>:5432/<backend-db>
CHAIN_ID=143
# Load-balanced RPC endpoints, comma-separated.
RPC_URLS=https://your-rpc.example
RELAYER_URL=https://relayer.trendr.bid
# A new pair for Mainnet; the public half is the backend's AUTOPILOT_SEAL_PUBLIC_KEY.
AUTOPILOT_SEAL_PRIVATE_KEY=<mainnet sealing private key>
# The Mainnet bot wallet and its Perpl API key, created at app.perpl.xyz/apikeys with this wallet
# (trade scope). Testnet keys do not work on Mainnet.
AUTOPILOT_BOT_ADDRESS=<mainnet bot wallet>
BOT_VENUE=api
AUTOPILOT_BOT_PRIVATE_KEY=
PERPL_API_TOKEN=<mainnet perpl api token>
PERPL_API_SECRET_KEY=<mainnet perpl ed25519 seed>
ALERT_WEBHOOK_URL=<slack or discord webhook>
