# Trend Autopilot and copy-trading executor. Copy to .env and fill in.

# The backend's database (the backend owns the schema and runs migrations).
DATABASE_URL=postgres://trendr:password@localhost:5432/trendr
CHAIN_ID=10143
# Load-balanced RPC endpoints, comma-separated.
RPC_URLS=https://testnet-rpc.monad.xyz
# The relayer that pays gas for accounts' session batches.
RELAYER_URL=http://localhost:4100

# Opens Autopilot grants the app sealed to this executor. Generate a pair with: bun scripts/seal-keys.ts
# (the public half goes in the backend's AUTOPILOT_SEAL_PUBLIC_KEY). Without it only the bot trades.
AUTOPILOT_SEAL_PRIVATE_KEY=

# The Trendr bot: its wallet and its Perpl API key (created at testnet.perpl.xyz/apikeys with this wallet, trade scope).
AUTOPILOT_BOT_ADDRESS=
# api: Perpl's signed API; chain: the bot wallet sends orders to the Exchange itself (needs the key below).
BOT_VENUE=api
AUTOPILOT_BOT_PRIVATE_KEY=
PERPL_API_TOKEN=
# Ed25519 seed, 32 bytes hex.
PERPL_API_SECRET_KEY=

TICK_SEC=15
# Worst accepted fill for market orders, basis points from the mark.
SLIPPAGE_BPS=50
FILL_TIMEOUT_SEC=30
MAX_CONSECUTIVE_FAILURES=3
# Any value halts Autopilot from the environment (the admin kill switch does the same at runtime).
KILL_SWITCH=
PORT=4400
LOG_LEVEL=info
ALERT_WEBHOOK_URL=
