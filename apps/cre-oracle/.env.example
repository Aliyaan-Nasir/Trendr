# Copy to .env (gitignored). The simulator broadcasts from CRE_ETH_PRIVATE_KEY: 64 hex characters,
# no 0x prefix. On Testnet it must be the TrendRegistry's trusted broadcaster.
CRE_ETH_PRIVATE_KEY=
# Elfa (X and Telegram attention), used by sources in direct mode. https://docs.elfa.ai
# On free plans keep Elfa in collector mode: the backend paces their monthly credits.
CRE_ELFA_API_KEY=
# Reddit app credentials (script or installed app, client-credentials grant).
CRE_REDDIT_CLIENT_ID=
CRE_REDDIT_CLIENT_SECRET=
# Nansen smart-money data for direct mode, needed to open crypto trends. https://docs.nansen.ai
CRE_NANSEN_API_KEY=
# The backend's ORACLE_TOKEN: bearer for its candidate queue and measurement collector.
CRE_BACKEND_TOKEN=
