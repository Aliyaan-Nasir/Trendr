# Monad Mainnet while the registry runs in mock mode: copy to .env.mainnet (gitignored). The Mainnet
# loop and `pnpm cre:simulate:mainnet` read only this file, never .env, so Testnet keys never sign
# Mainnet reports. On a platform, export the same variables instead. docs/mainnet.md has the runbook.

# The broadcaster the Mainnet registry trusts (CRE_BROADCASTER at deploy): 64 hex characters, no 0x
# prefix. A new key that holds only MON for report gas, about 10 MON a day at twelve live trends.
CRE_ETH_PRIVATE_KEY=
# The Mainnet backend's ORACLE_TOKEN.
CRE_BACKEND_TOKEN=
# Direct-mode source keys; every Mainnet source reads through the backend collector, so these stay
# empty unless a source switches to direct mode.
CRE_ELFA_API_KEY=
CRE_REDDIT_CLIENT_ID=
CRE_REDDIT_CLIENT_SECRET=
CRE_NANSEN_API_KEY=
