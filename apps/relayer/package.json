{
  "name": "@trendr/relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gas sponsor for Trendr PasskeyAccount batches on Monad.",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:e2e": "RELAYER_E2E=1 bun test test/e2e.anvil.test.ts",
    "test:fork:mainnet": "RELAYER_MAINNET_FORK=1 bun test test/e2e.mainnet-fork.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trendr/chain": "file:../../packages/chain",
    "@trendr/contracts": "file:../../packages/contracts-ts",
    "hono": "4.12.18",
    "pino": "10.3.1",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@trendr/perpl": "file:../../packages/perpl",
    "@types/bun": "1.3.1",
    "typescript": "5.9.3"
  }
}
