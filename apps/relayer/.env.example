# Monad RPC and chain. Contract addresses come from @trendr/contracts deployments.
RPC_URL=https://testnet-rpc.monad.xyz
# Several endpoints to load-balance across (round robin with failover), comma-separated.
RPC_URLS=
CHAIN_ID=10143
# Comma-separated relayer keys (0x-prefixed). They only hold gas money. Several keys raise
# throughput, because Monad limits how much one account can have in flight.
RELAYER_PRIVATE_KEYS=
PORT=4100
# Comma-separated app origins allowed to call the relayer.
ALLOWED_ORIGINS=http://localhost:3000
# Largest daily AUSD session limit (raw units) the relayer sponsors activation for.
MAX_SESSION_DAILY_LIMIT=1000000000
# Longest session lifetime (seconds) the relayer sponsors activation for.
MAX_SESSION_LIFETIME=2592000
LOG_LEVEL=info
# MON each sponsor key should keep; /v1/health turns red when every key is below it.
MIN_BALANCE_MON=1
# Proxies in front of the relayer that append the caller to X-Forwarded-For. 0 (no proxy) takes the
# client address from the socket and ignores the header; n takes the entry n places from the right.
# Railway's edge is one proxy: set 1 there, or every caller shares the proxy's address limits.
TRUSTED_PROXY_HOPS=0
# Sponsorship budgets, in gas limit (Monad bills the limit even when a transaction reverts).
# Per account per UTC day, activation included, and all accounts together per rolling hour.
ACCOUNT_GAS_PER_DAY=40000000
RELAYER_GAS_PER_HOUR=300000000
# Activations paid for per rolling hour in total, and per client address per hour.
ACTIVATIONS_PER_HOUR=60
ACTIVATIONS_PER_IP_PER_HOUR=5
# The backend's activation ticket key (the address of its ACTIVATION_TICKET_KEY). Set, every
# activation needs a ticket the backend signed after its sign-up checks; empty, none is needed.
ACTIVATION_TICKET_SIGNER=
# From this many reverted relays in a UTC day, each further one pauses the account this long.
REVERTS_BEFORE_COOLDOWN=3
REVERT_COOLDOWN_SECONDS=3600
