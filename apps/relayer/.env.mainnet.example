# Monad Mainnet: only the values that differ from .env.example. Start from .env.example, then apply
# these. docs/mainnet.md has the measured costs behind the budgets. Never commit the filled-in file.

RPC_URL=https://your-rpc.example
# Comma-separated, load balanced with failover.
RPC_URLS=https://your-rpc.example
CHAIN_ID=143
# New Mainnet keys that hold only MON for gas, comma-separated; several keys raise throughput.
RELAYER_PRIVATE_KEYS=<0x mainnet relayer key>
ALLOWED_ORIGINS=https://app.trendr.bid
TRUSTED_PROXY_HOPS=1
# Session limits sponsored at activation. These move real AUSD on Mainnet: 250 AUSD a day, 7 days.
MAX_SESSION_DAILY_LIMIT=250000000
MAX_SESSION_LIFETIME=604800
# The topup service refills a key below 2 MON (apps/topup TARGETS min), so /v1/health turns red only
# when every key is below that, which means refills have stopped.
MIN_BALANCE_MON=2
# Budgets in gas limit, which Monad bills (about 102 gwei: 0.0102 MON per 100,000 gas); the relayer
# sets each limit 20% above its estimate. Measured on a Mainnet fork (gas used, then limit and MON):
#   activation (7702 delegation plus initialize)  0.28M  0.34M  0.035 MON
#   session approve and mint                      0.35M  0.43M  0.043 MON
#   session TrendrSpot trade on Kuru              0.56M  0.67M  0.068 MON
#   passkey withdrawal                            0.10M  0.12M  0.012 MON
#   passkey USDC to AUSD conversion (Aurora)      0.28M  0.34M  0.035 MON
# A relay first reserves its cap (session 2M, owner 1.5M, activation 1.04M) and then keeps only the
# limit it sent, so each budget needs that much room left for the next relay.
# Per account per UTC day (Testnet 40M): 10M, about 1 MON, covers activation and about a dozen trades.
ACCOUNT_GAS_PER_DAY=10000000
# All accounts per rolling hour (Testnet 300M): 40M, about 4.1 MON, about 60 Kuru trades or 90
# mints. Three keys at 25 MON last about 18 hours at that ceiling; the topup service adds at most
# 15 MON a key a day (about 1.9 MON an hour for all three).
RELAYER_GAS_PER_HOUR=40000000
# Activations paid per rolling hour (Testnet 60), about 1 MON at most, and per client address (Testnet 5).
ACTIVATIONS_PER_HOUR=30
ACTIVATIONS_PER_IP_PER_HOUR=3
# Every Mainnet activation needs the backend's ticket: the address of its ACTIVATION_TICKET_KEY.
ACTIVATION_TICKET_SIGNER=<backend ticket key address>
