# Monad RPC, WebSocket and chain. Contract addresses come from @trendr/contracts deployments.
RPC_URL=https://testnet-rpc.monad.xyz
WS_URL=wss://testnet-rpc.monad.xyz
# Several endpoints to load-balance across (round robin with failover), comma-separated.
# RPC_URL and WS_URL alone when unset.
RPC_URLS=
WS_URLS=
CHAIN_ID=10143
# Requests per second to RPC_URL. The public RPC allows 15 per IP across all processes.
RPC_MAX_RPS=10
# The keeper's own key. It only holds gas money and earns liquidation rewards.
KEEPER_PRIVATE_KEY=
PORT=4200
# Windows (seconds) to keep a series open in, and those whose series get Kuru markets.
# Testnet also offers a 900 second drill window; listing it costs two Kuru markets per series.
SERIES_WINDOWS=86400,604800
LIST_WINDOWS=86400,604800
SCAN_EVERY_BLOCKS=25
POLL_MS=2000
MAX_ACTIONS_PER_SCAN=12
HEAD_LAG_ALERT_SEC=30
# Optional Slack or Discord webhook for alerts.
ALERT_WEBHOOK_URL=
LOG_LEVEL=info
