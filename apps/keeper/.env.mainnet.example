# Monad Mainnet: only the values that differ from .env.example. Start from .env.example, then apply
# these. docs/mainnet.md has the runbook. Never commit the filled-in file.

RPC_URL=https://your-rpc.example
WS_URL=wss://your-rpc.example
# Comma-separated, load balanced with failover.
RPC_URLS=https://your-rpc.example
WS_URLS=wss://your-rpc.example
CHAIN_ID=143
RPC_MAX_RPS=25
# A new Mainnet key holding MON for gas: an openSeries costs about 0.25 MON, so about 3.6 MON a day
# at twelve live trends once 24 hour and 7 day series open; a few hundredths a day before that.
KEEPER_PRIVATE_KEY=<0x mainnet keeper key>
# Up/Down goes live last (docs/mainnet.md): until then open no series, so the keeper only retires,
# settles retired trends, liquidates and marks perps. Then set the windows agreed with Kuru, for
# example 86400,604800 (no 900 second test window); Kuru can deploy a series' markets once it opens.
SERIES_WINDOWS=
# Kuru Mainnet deploys markets only through its own Safe, so OutcomeListing.list reverts NotDeployed
# until Kuru has deployed a series' canonical markets. Leave empty until Kuru deploys them for the
# windows it agreed to, then list those windows only.
LIST_WINDOWS=
ALERT_WEBHOOK_URL=<slack or discord webhook>
