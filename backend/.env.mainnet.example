# Monad Mainnet: only the values that differ from .env.example. Start from .env.example, then apply
# these. docs/mainnet.md has the full runbook. Never commit the filled-in file.

# Chain. Use dedicated provider endpoints first; the public RPC allows 15 requests a second per IP.
CHAIN_ID=143
# Comma-separated, load balanced with failover.
MONAD_RPC_URLS=https://your-rpc.example
# Leave empty: the bundled deployment for 143 comes from contracts/deployments/143.json.
DEPLOYMENT_JSON=

# The Mainnet backend's own database, never the Testnet one.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<backend-db>

# Production origins of the app and the admin panel, comma-separated (add https://admin.trendr.bid).
FRONTEND_URL=https://app.trendr.bid
# Contact details on the production domain: Wikimedia allows more requests, and push services
# reach the sender through the VAPID subject.
WIKIMEDIA_USER_AGENT=TrendrAttentionIndex/1.0 (https://trendr.bid)
VAPID_SUBJECT=https://trendr.bid
# One proxy (Railway's edge) in front of the backend.
TRUSTED_PROXY_HOPS=1

# The Mainnet indexer's database: it runs as its own indexer (indexer/config.mainnet.yaml).
INDEXER_DATABASE_URL=postgres://<user>:<password>@<host>:5432/<indexer-db>
INDEXER_SCHEMA=indexer

# New secrets for Mainnet. ORACLE_TOKEN must equal the CRE workflow's CRE_BACKEND_TOKEN secret.
ORACLE_TOKEN=<openssl rand -base64 32>
# Comma-separated.
ADMIN_ADDRESSES=0xYourAdminAddress
ADMIN_SESSION_SECRET=<openssl rand -hex 32>

# Aurora deposits go live on 143 only, and only with a key (deposit routes are not mounted without it).
# The integrator fee and persistent deposit addresses are portal settings on this key.
AURORA_API_KEY=<aurora api key>

# Autopilot on Mainnet: a new sealing pair (apps/autopilot: bun scripts/seal-keys.ts) and the Mainnet bot wallet.
AUTOPILOT_SEAL_PUBLIC_KEY=<mainnet sealing public key>
AUTOPILOT_BOT_ADDRESS=<mainnet bot wallet>

# No faucet on Mainnet: leave the key empty (the faucet is built only on 10143 anyway).
FAUCET_PRIVATE_KEY=

# A new Mainnet key that signs activation tickets; the relayer's ACTIVATION_TICKET_SIGNER is its address.
ACTIVATION_TICKET_KEY=<0x mainnet ticket key>

# Health endpoints of the Mainnet services, one name=url entry each (keeper, market-maker, relayer
# at /v1/health, autopilot, topup), comma-separated.
STATUS_SERVICES=keeper=https://<keeper-host>/health
# The Mainnet oracle runs every minute and re-reports every trend at least every 12 minutes
# (heartbeat 720 s), so a gap past the registry's 15 minute staleness limit is an outage.
ORACLE_STALE_SEC=900
