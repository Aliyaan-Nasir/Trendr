# Trendr backend: trend radar, measurement collector and app API.
# Copy to .env and fill in. Empty optional values count as unset.

PORT=4000
LOG_LEVEL=info
# Postgres. Local databases skip TLS; hosted ones require it.
DATABASE_URL=postgres://trendr:password@localhost:5432/trendr
# Only for `bun test`: a database the tests may truncate.
TEST_DATABASE_URL=postgres://trendr:password@localhost:5432/trendr_test
# The Envio indexer's database and schema (indexer/); the same database works. Without it the
# history endpoints (track records, trade history, trader leaderboard, trend stats) answer 503.
INDEXER_DATABASE_URL=postgres://trendr:password@localhost:5432/trendr_envio
INDEXER_SCHEMA=indexer
# Comma-separated app origins allowed by CORS (the app, and the admin panel on 3001 locally).
FRONTEND_URL=http://localhost:3000
# Comma-separated website origins allowed by CORS for the Mainnet waitlist form only (production:
# https://trendr.bid). The landing page runs on 3004 locally.
LANDING_URL=http://localhost:3004
# Proxies in front of the backend that append the client's address to X-Forwarded-For. Every IP
# rate limit takes the entry this many positions from the right; anything further left is written
# by the client. 0 (no proxy) ignores the header and uses the socket address. Railway needs 1.
TRUSTED_PROXY_HOPS=0

# Chain: 10143 (Testnet) or 143 (Mainnet). Several RPC endpoints are load balanced with failover.
CHAIN_ID=10143
MONAD_RPC_URLS=https://testnet-rpc.monad.xyz
# Instead of the bundled deployment for CHAIN_ID (tests and forks).
DEPLOYMENT_JSON=

# Bearer token the CRE workflow sends to /v1/oracle/*. Generate with: openssl rand -base64 32
ORACLE_TOKEN=
# Wallets allowed to call /v1/admin/* (signed requests), comma-separated.
ADMIN_ADDRESSES=
# Signs admin session tokens (openssl rand -hex 32); unset means a new key, and new sign-ins, per start.
ADMIN_SESSION_SECRET=

# Elfa API keys, comma-separated, with their daily and monthly credit budgets.
ELFA_API_KEYS=
ELFA_DAILY_CREDITS_PER_KEY=100
ELFA_MONTHLY_CREDITS_PER_KEY=950
# Read each key's month-to-date usage and plan from Elfa on start, in the background, one key at a
# time (one credit each). Off by default: usage is counted locally.
ELFA_SYNC_USAGE=off
# Elfa calls go out one at a time, a random gap apart; each key rests between its own uses, and its
# daily credits open hour by hour. Key checks go one key at a time, a random gap apart.
ELFA_MIN_GAP_SEC=20
ELFA_MAX_GAP_SEC=90
ELFA_KEY_MIN_GAP_SEC=600
ELFA_HOURLY_SLACK=2
ELFA_CHECK_GAP_MIN_SEC=30
ELFA_CHECK_GAP_MAX_SEC=90

# Nansen API keys, comma-separated. The free plan tops up to 10 credits a day; netflow costs 5.
NANSEN_API_KEYS=
NANSEN_DAILY_CREDITS_PER_KEY=10
NANSEN_CHAINS=all

# Wikimedia allows 10 requests a minute without contact details in the User-Agent and 200 with a
# URL or email, for example in production: TrendrAttentionIndex/1.0 (https://trendr.bid)
WIKIMEDIA_USER_AGENT=TrendrAttentionIndex/1.0 (attention markets on Monad)

# AI for the radar, tried in order: Gemini, Gemini fallback model, OpenAI, Kimi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_API_BASE=https://api.moonshot.ai/v1
# AI provider requests per UTC day (fallbacks count), shared by the radar and pasted links. Links
# pause once half is spent, so the radar always keeps the other half.
AI_DAILY_CALLS=400

# Radar: every run, Elfa trending tokens, CoinGecko's and GeckoTerminal's trending lists and
# Bluesky's trending topics (keyless, each fetched at most every 10 minutes); Elfa narratives
# (5 credits, paid keys only) every NARRATIVES_EVERY runs; Wikipedia's most-read articles once a day.
RADAR_INTERVAL_SEC=7200
NARRATIVES_EVERY=6
# Radar runs between Elfa trending-token calls (1 credit each). With a single free key (about 32
# credits a day) raise it, for example to 6, so the collector's live trends keep most credits.
ELFA_TOKENS_EVERY=1
AUTO_APPROVE_CONFIDENCE=0.8
# Crypto candidates reach the workflow once smart money confirms them; match the workflow's minConfirmNetflowUsd.
CRYPTO_CONFIRM_NETFLOW_USD=100000

# Collector cadence and the shortest refresh per source. Elfa's interval stretches with the number
# of trends so the day's credits last.
COLLECT_INTERVAL_SEC=60
ELFA_REFRESH_SEC=7200
# GDELT: live trends every GDELT_REFRESH_SEC, candidates every GDELT_CANDIDATE_REFRESH_SEC.
GDELT_REFRESH_SEC=1800
GDELT_CANDIDATE_REFRESH_SEC=3600
NANSEN_REFRESH_SEC=14400
WIKIPEDIA_REFRESH_SEC=21600
# Keyless: Bluesky (one search per trend, a second apart) and Hacker News (up to three searches per trend).
BLUESKY_REFRESH_SEC=1800
HN_REFRESH_SEC=3600

# Autopilot: the executor's public sealing key (apps/autopilot: bun scripts/seal-keys.ts) and the bot wallet.
AUTOPILOT_SEAL_PUBLIC_KEY=
AUTOPILOT_BOT_ADDRESS=
PERPL_TAKER_FEE_BPS=4
BACKTEST_SLIPPAGE_BPS=5

# Web Push. Generate keys with: bunx web-push generate-vapid-keys. The subject is a mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://trendr.bid

# Testnet only: a wallet with test MON and AUSD that drips test AUSD to beta testers (raw, 6 decimals).
# It pays activated Trendr accounts only, once a day each, and at most FAUCET_DAILY_CAP drips a day.
FAUCET_PRIVATE_KEY=
FAUCET_AMOUNT=100000000
FAUCET_DAILY_CAP=200

# Signs activation tickets: the relayer pays for an account's activation only with one (set its
# ACTIVATION_TICKET_SIGNER to this key's address, which the backend logs at start). A ticket goes to
# a new account while the caller's address and everyone together are within these sign-up caps.
ACTIVATION_TICKET_KEY=
ACTIVATION_TICKETS_PER_IP_PER_HOUR=3
ACTIVATION_TICKETS_PER_IP_PER_DAY=10
ACTIVATION_TICKETS_PER_HOUR=30
ACTIVATION_TICKETS_PER_DAY=150

# The public status view checks these health endpoints, one name=url entry per service,
# comma-separated (keeper 4200, market-maker 4300, relayer 4100 at /v1/health, autopilot 4400,
# topup 4500); the admin operations view reads the same endpoints in detail (wallets, alerts, the
# top-up treasury).
STATUS_SERVICES=keeper=http://localhost:4200/health
# The admin system view (GET /v1/admin/system) also checks these, which the public view never
# names (name=url, comma-separated). An entry in either list may add |-separated flags for the
# admin system view: optional (its outage is a warning, not critical) and staleMin=<minutes>
# (it reads as stalled after that long without work; keeper, market-maker, autopilot and topup
# have defaults), for example worker=http://localhost:4600/health|optional|staleMin=60.
ADMIN_SERVICES=
ORACLE_STALE_SEC=600

# off disables the radar and collector loops (API only).
BACKGROUND=on
