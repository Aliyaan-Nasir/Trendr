# Copy to .env.local and fill in. NEXT_PUBLIC_ values are inlined into the bundle at build time,
# so set them before `npm run build`.

# Trendr backend origin. The browser calls it directly, so the backend's FRONTEND_URL must list
# this panel's origin (http://localhost:3001 in development).
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Optional, comma-separated 0x addresses expected to be admins. Only a hint on the sign-in screen:
# the backend checks its own ADMIN_ADDRESSES on every request, so this list grants nothing.
NEXT_PUBLIC_ADMIN_WALLETS=
